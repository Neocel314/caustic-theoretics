---
import { postUrl, dateLabel, type Post } from '../lib/writing';
const { posts } = Astro.props as { posts: Post[] };
---
<ul class="post-list">
  {posts.map(post => <li><time datetime={post.data.date.toISOString()}>{dateLabel(post.data.date)}</time><a href={postUrl(post)}>{post.data.title}</a></li>)}
</ul>
