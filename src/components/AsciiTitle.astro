---
// Text, rather than an image: the masthead stays sharp and needs no font download.
const letters: Record<string, string[]> = {
  A: ['01110','11011','11011','11111','11011','11011','11011'],
  C: ['01111','11000','11000','11000','11000','11000','01111'],
  E: ['11111','11000','11000','11110','11000','11000','11111'],
  I: ['11111','00100','00100','00100','00100','00100','11111'],
  N: ['11001','11101','11101','11011','11011','11001','11001'],
  O: ['01110','11011','11011','11011','11011','11011','01110'],
  P: ['11110','11011','11011','11110','11000','11000','11000'],
  R: ['11110','11011','11011','11110','11100','11010','11011'],
  S: ['01111','11000','11000','01110','00011','00011','11110'],
  T: ['11111','00100','00100','00100','00100','00100','00100'],
  U: ['11011','11011','11011','11011','11011','11011','01110'],
};
const renderWord = (word: string) => Array.from({length: 7}, (_, row) => [...word].map(letter => letters[letter][row].replaceAll('1', '#').replaceAll('0', ' ')).join('  ')).join('\n');
---
<span class="ascii-title" aria-hidden="true"><span>{renderWord('CAUSTIC')}</span><span>{renderWord('PRESCRIPTIONS')}</span></span>
